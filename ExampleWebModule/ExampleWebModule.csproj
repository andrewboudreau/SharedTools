<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<AssemblyName>SharedTools.ExampleWebModule</AssemblyName>
		<TargetFramework>net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		
		<!-- Ensure Razor views are compiled into the main assembly -->
		<RazorCompileOnBuild>true</RazorCompileOnBuild>
		<RazorCompileOnPublish>true</RazorCompileOnPublish>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>

		<!-- A module ships as a drop (dotnet publish output), not a NuGet package. -->
		<IsPackable>false</IsPackable>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />

		<!-- The contract comes from the host at runtime, so it stays out of the drop. -->
		<ProjectReference Include="..\SharedTools.Web\SharedTools.Web.csproj" Private="false" ExcludeAssets="runtime" />
	</ItemGroup>
	
</Project>
