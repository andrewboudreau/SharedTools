<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Compile Razor into the assembly so the module is self-contained. -->
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <RazorCompileOnPublish>true</RazorCompileOnPublish>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- A module ships as a drop: `dotnet publish -o out`, zipped and uploaded. Not a NuGet package. -->
    <IsPackable>false</IsPackable>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- Compile against the contract; the host supplies SharedTools.Web at runtime. -->
    <PackageReference Include="SharedTools.Web" Version="SHAREDTOOLS_VERSION" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
