<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Compile Razor into the assembly so the module is self-contained. -->
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <RazorCompileOnPublish>true</RazorCompileOnPublish>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>

    <!-- Pack the module so a host can load it from NuGet. -->
    <PackageId>SharedTools.ModuleTemplate</PackageId>
    <Version>0.1.0</Version>
    <GeneratePackageOnBuild Condition="'$(CI)' != 'true'">true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <PackageReference Include="SharedTools.Web" Version="SHAREDTOOLS_VERSION">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Embed static assets (HTML/CSS/JS) into the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

  <!-- During Debug, drop the package into a local feed for quick host testing. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageOutputPath>C:\LocalNuGet</PackageOutputPath>
  </PropertyGroup>

</Project>
