<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>SharedTools.Templates</PackageId>
    <Version>0.1.0</Version>
    <Title>SharedTools module templates</Title>
    <Authors>Andrew Boudreau</Authors>
    <Description>dotnet new templates for SharedTools web modules.</Description>
    <PackageTags>dotnet-new;templates;sharedtools;webmodule</PackageTags>
    <TargetFramework>net10.0</TargetFramework>

    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SharedTools.Module\**\*" Exclude="SharedTools.Module\**\bin\**;SharedTools.Module\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
