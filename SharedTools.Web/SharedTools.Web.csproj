<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- NuGet Package Information -->
		<IsPackable>true</IsPackable>
		<PackageId>SharedTools.Web</PackageId>
		<Version>3.0.0</Version>
		<Authors>Andrew Boudreau</Authors>
		<Description>Load ASP.NET Core web modules (Razor Pages, endpoints, static files) from dotnet publish drops at startup.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/andrewboudreau/SharedTools</RepositoryUrl>
		<PackageTags>web;modules;aspnetcore</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

</Project>
